CATNANNY_DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000
# rules: offline demo; openai: Responses API extraction. Secrets stay server-side.
CATNANNY_EXTRACTION_PROVIDER=rules
OPENAI_API_KEY=
# Choose a Responses + Structured Outputs compatible model available to your account.
# Previously verified in this project; confirm availability for your own account.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
